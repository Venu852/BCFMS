# Copy to .env and adjust. Every value is optional in development.
BCFMS_SECRET_KEY=change-me
BCFMS_VAULT_KEY=change-me-and-never-lose-it
BCFMS_DEBUG=1
BCFMS_ALLOWED_HOSTS=127.0.0.1,localhost
BCFMS_TIME_ZONE=Asia/Kolkata

# Require an authenticator app for Admin / Investigating Officer / Forensic / Judiciary
BCFMS_ENFORCE_MFA=0

# Local LLM-RAG (Gemma 4 E2B GGUF, run in-process by llama.cpp)
BCFMS_LLM_ENABLED=1
BCFMS_LLM_PATH=models/gemma-4-E2B-it-GGUF/gemma-4-E2B-it-Q4_K_M.gguf
BCFMS_EMBED_PATH=models/all-MiniLM-L6-v2
# -1 = every layer on the GPU, 0 = CPU only
BCFMS_LLM_GPU_LAYERS=-1
BCFMS_LLM_CONTEXT=8192
BCFMS_LLM_MAX_NEW_TOKENS=450
